---
import DocCard from './DocCard.astro';
import type { Doc } from '../lib/documents';

interface Props {
	/** Unique per page; used to keep each library's filter state and element IDs separate. */
	id: string;
	/** Name used in labels, e.g. "Power BI". */
	label: string;
	docs: Doc[];
	headingLevel?: 3 | 4;
}

const { id, label, docs, headingLevel = 3 } = Astro.props;
const tags = [...new Set(docs.flatMap((d) => d.tags))].sort();
---

{
	docs.length === 0 ? (
		<p class="placeholder">Content coming soon.</p>
	) : (
		<div class="library" data-library={id} role="region" aria-label={`${label} documents`}>
			{/* Controls stay hidden until the script runs, so without JS you simply see every card. */}
			<div class="controls" data-controls hidden>
				<div class="search">
					<label for={`${id}-search`}>Search {label}</label>
					<input id={`${id}-search`} type="search" autocomplete="off" placeholder="Title, description or tag" data-search-input />
				</div>

				{tags.length > 0 && (
					<div class="tag-filter" role="group" aria-labelledby={`${id}-tags-label`}>
						<span id={`${id}-tags-label`} class="tag-filter-label">
							Filter by tag
						</span>
						<ul>
							{tags.map((tag) => (
								<li>
									<button type="button" class="filter-chip" aria-pressed="false" data-filter-tag={tag}>
										{tag}
									</button>
								</li>
							))}
						</ul>
					</div>
				)}

				<div class="status">
					<p class="count" aria-live="polite" data-count>
						Showing {docs.length} of {docs.length}
					</p>
					<button type="button" class="btn btn--secondary clear" data-clear>
						Clear filters
					</button>
				</div>
			</div>

			<ul class="cards" data-cards>
				{docs.map((doc) => (
					<DocCard doc={doc} headingLevel={headingLevel} />
				))}
			</ul>
			<p class="placeholder" data-empty hidden>
				No documents match your filters.
			</p>
		</div>
	)
}

<script>
	function setUp(library: HTMLElement) {
		const controls = library.querySelector<HTMLElement>('[data-controls]')!;
		const input = library.querySelector<HTMLInputElement>('[data-search-input]')!;
		const chips = [...library.querySelectorAll<HTMLButtonElement>('[data-filter-tag]')];
		const cards = [...library.querySelectorAll<HTMLElement>('[data-doc]')];
		const count = library.querySelector<HTMLElement>('[data-count]')!;
		const empty = library.querySelector<HTMLElement>('[data-empty]')!;
		const clear = library.querySelector<HTMLButtonElement>('[data-clear]')!;
		const selected = new Set<string>();

		function apply() {
			const words = input.value.toLowerCase().split(/\s+/).filter(Boolean);
			let shown = 0;
			for (const card of cards) {
				const text = card.dataset.search ?? '';
				const cardTags = (card.dataset.tags ?? '').split(' ');
				const match =
					words.every((w) => text.includes(w)) && [...selected].every((t) => cardTags.includes(t));
				card.hidden = !match;
				if (match) shown++;
			}
			for (const chip of chips) chip.setAttribute('aria-pressed', String(selected.has(chip.dataset.filterTag!)));
			for (const btn of library.querySelectorAll<HTMLButtonElement>('[data-tag-toggle]')) {
				btn.setAttribute('aria-pressed', String(selected.has(btn.dataset.tagToggle!)));
			}
			count.textContent = `Showing ${shown} of ${cards.length}`;
			empty.hidden = shown > 0;
			clear.disabled = !input.value && selected.size === 0;
		}

		function toggle(tag: string) {
			if (selected.has(tag)) selected.delete(tag);
			else selected.add(tag);
			apply();
		}

		input.addEventListener('input', apply);
		library.addEventListener('click', (e) => {
			const target = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-filter-tag], [data-tag-toggle]');
			if (target) toggle(target.dataset.filterTag ?? target.dataset.tagToggle!);
		});
		clear.addEventListener('click', () => {
			input.value = '';
			selected.clear();
			apply();
			input.focus();
		});

		controls.hidden = false;
		apply();
	}

	document.querySelectorAll<HTMLElement>('[data-library]').forEach(setUp);
</script>

<style>
	.controls {
		display: grid;
		gap: 0.85rem;
		margin-bottom: 1.25rem;
		padding: 1rem;
		border: 1px solid var(--color-border);
		border-radius: 0.6rem;
		background: var(--color-surface);
	}

	.controls[hidden] {
		display: none;
	}

	.search {
		display: grid;
		gap: 0.3rem;
	}

	label,
	.tag-filter-label {
		font-weight: 600;
		font-size: 0.9rem;
	}

	input[type='search'] {
		width: 100%;
		max-width: 28rem;
		min-height: 2.6rem;
		padding: 0.5rem 0.75rem;
		border: 1px solid var(--color-border);
		border-radius: 0.375rem;
		background: var(--color-surface-raised);
		color: var(--color-text);
		font: inherit;
	}

	input[type='search']::placeholder {
		color: var(--color-text-muted);
	}

	.tag-filter {
		display: grid;
		gap: 0.35rem;
	}

	.tag-filter ul {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.filter-chip {
		min-height: 2rem;
		padding: 0.25rem 0.75rem;
		border: 1px solid var(--color-border);
		border-radius: 999px;
		background: var(--color-surface-raised);
		color: var(--color-text);
		font: inherit;
		font-size: 0.85rem;
		cursor: pointer;
	}

	.filter-chip:hover {
		border-color: var(--color-accent);
	}

	.filter-chip[aria-pressed='true'] {
		background: var(--color-accent);
		border-color: var(--color-accent);
		color: var(--color-on-accent);
	}

	.filter-chip[aria-pressed='true']::before {
		content: '✓ ';
	}

	.status {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 0.5rem 1rem;
	}

	.count {
		margin: 0;
		color: var(--color-text-muted);
		font-size: 0.9rem;
	}

	.clear {
		min-height: 2.2rem;
		padding-block: 0.3rem;
		font-size: 0.85rem;
	}

	.clear:disabled {
		opacity: 0.55;
		cursor: default;
	}

	.cards {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(min(100%, 19rem), 1fr));
		gap: 1rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.placeholder[data-empty] {
		margin-top: 1rem;
	}

	.placeholder[hidden] {
		display: none;
	}
</style>
