---
import { loadPractices } from '../lib/practices';

const DAYS = [
	{ key: 'mon', label: 'Monday' },
	{ key: 'tue', label: 'Tuesday' },
	{ key: 'wed', label: 'Wednesday' },
	{ key: 'thu', label: 'Thursday' },
	{ key: 'fri', label: 'Friday' },
	{ key: 'sat', label: 'Saturday' },
	{ key: 'sun', label: 'Sunday' },
];

const TIMEZONES = [
	{ value: 'America/New_York', label: 'Eastern (America/New_York)' },
	{ value: 'America/Chicago', label: 'Central (America/Chicago)' },
	{ value: 'America/Denver', label: 'Mountain (America/Denver)' },
	{ value: 'America/Phoenix', label: 'Arizona, no daylight saving (America/Phoenix)' },
	{ value: 'America/Los_Angeles', label: 'Pacific (America/Los_Angeles)' },
	{ value: 'America/Anchorage', label: 'Alaska (America/Anchorage)' },
	{ value: 'Pacific/Honolulu', label: 'Hawaii (Pacific/Honolulu)' },
];

// Numbers already in practices.csv, so the form can warn about duplicates before submitting.
// Numbers added through the form are fetched from /api/practices when the page loads.
const existing = JSON.stringify(Object.keys(loadPractices()));
---

<noscript><p class="placeholder">Adding a practice needs JavaScript turned on in your browser.</p></noscript>

<div class="np-done" tabindex="-1" hidden data-np-done>
	<h3>Practice added</h3>
	<p data-np-done-text></p>
	<p class="np-done-actions">
		<a class="btn" href="#practice-info" data-np-view>Look it up</a>
		<button type="button" class="btn btn--secondary" data-np-again>Add another practice</button>
	</p>
</div>

<form class="np" novalidate hidden data-np-form>
	<p class="visually-hidden">
		<label>Leave this empty: <input name="bot_field" tabindex="-1" autocomplete="off" /></label>
	</p>

	<div class="np-summary" tabindex="-1" role="alert" hidden data-np-summary>
		<h3 class="np-summary-title">Please fix the following</h3>
		<ul data-np-summary-list></ul>
	</div>

	<fieldset>
		<legend>Practice</legend>
		<div class="np-field">
			<label for="np-name">Practice name <span class="req">(required)</span></label>
			<input id="np-name" name="practice_name" required autocomplete="organization" />
		</div>
		<div class="np-field">
			<label for="np-numbers">Phone numbers <span class="req">(required)</span></label>
			<p class="hint" id="np-numbers-hint">One per line. Any format works, e.g. (813) 555-0101.</p>
			<textarea id="np-numbers" name="numbers" rows="3" required aria-describedby="np-numbers-hint"></textarea>
		</div>
	</fieldset>

	<fieldset>
		<legend>Address</legend>
		<div class="np-field">
			<label for="np-addr1">Street address</label>
			<input id="np-addr1" name="address_line1" autocomplete="address-line1" />
		</div>
		<div class="np-field">
			<label for="np-addr2">Suite, building, etc.</label>
			<input id="np-addr2" name="address_line2" autocomplete="address-line2" />
		</div>
		<div class="np-row">
			<div class="np-field np-city">
				<label for="np-city">City</label>
				<input id="np-city" name="city" autocomplete="address-level2" />
			</div>
			<div class="np-field np-state">
				<label for="np-state">State</label>
				<input id="np-state" name="state" maxlength="2" autocomplete="address-level1" placeholder="FL" />
			</div>
			<div class="np-field np-zip">
				<label for="np-zip">ZIP</label>
				<input id="np-zip" name="zip" inputmode="numeric" autocomplete="postal-code" />
			</div>
		</div>
	</fieldset>

	<fieldset>
		<legend>Hours of operation</legend>
		<p class="hint">Leave a day blank if you don't know it. Put lunch breaks in the notes.</p>
		<table class="np-hours">
			<thead>
				<tr>
					<th scope="col">Day</th>
					<th scope="col">Opens</th>
					<th scope="col">Closes</th>
					<th scope="col">Closed all day</th>
				</tr>
			</thead>
			<tbody>
				{
					DAYS.map((d) => (
						<tr data-np-day={d.key}>
							<th scope="row">{d.label}</th>
							<td>
								<input type="time" name={`${d.key}_open`} aria-label={`${d.label} opens`} data-np-open />
							</td>
							<td>
								<input type="time" name={`${d.key}_close`} aria-label={`${d.label} closes`} data-np-close />
							</td>
							<td>
								<input type="checkbox" name={`${d.key}_closed`} value="yes" aria-label={`Closed ${d.label}`} data-np-closed />
							</td>
						</tr>
					))
				}
			</tbody>
		</table>
		<button type="button" class="btn btn--secondary" hidden data-np-copy>Copy Monday's hours to Tuesday–Friday</button>
	</fieldset>

	<fieldset>
		<legend>Time zone <span class="req">(required)</span></legend>
		<div class="np-field">
			<label for="np-tz" class="visually-hidden">Time zone</label>
			<select id="np-tz" name="timezone" required>
				<option value="">Choose a time zone…</option>
				{TIMEZONES.map((tz) => <option value={tz.value}>{tz.label}</option>)}
			</select>
		</div>
	</fieldset>

	<fieldset>
		<legend>Notes</legend>
		<div class="np-field">
			<label for="np-notes" class="visually-hidden">Notes</label>
			<textarea id="np-notes" name="notes" rows="3" placeholder="e.g. Lunch 12–1, closed the first Friday of the month"></textarea>
		</div>
	</fieldset>

	<fieldset>
		<legend>About you</legend>
		<div class="np-row">
			<div class="np-field">
				<label for="np-submitter">Your name <span class="req">(required)</span></label>
				<input id="np-submitter" name="submitted_by" required autocomplete="name" />
			</div>
			<div class="np-field">
				<label for="np-email">Your email</label>
				<input id="np-email" name="email" type="email" autocomplete="email" />
			</div>
		</div>
		<div class="np-field np-passcode">
			<label for="np-passcode">Team passcode <span class="req">(required)</span></label>
			<p class="hint" id="np-passcode-hint">Ask the Cloud Telephony team if you don't have it.</p>
			<input id="np-passcode" name="passcode" type="password" required autocomplete="off" aria-describedby="np-passcode-hint" />
		</div>
	</fieldset>

	<button type="submit" class="btn">Add practice</button>

	<script type="application/json" id="np-existing" set:html={existing} />
</form>

<script>
	const form = document.querySelector<HTMLFormElement>('[data-np-form]');

	/** "13:30" → "1:30 PM" */
	function to12h(value: string): string {
		const [h, m] = value.split(':').map(Number);
		return `${h % 12 || 12}:${String(m).padStart(2, '0')} ${h < 12 ? 'AM' : 'PM'}`;
	}

	/** Strips formatting; drops a leading country code 1 from 11 digits (same rule as the lookup). */
	function normalize(value: string): string {
		const digits = value.replace(/\D/g, '');
		return digits.length === 11 && digits.startsWith('1') ? digits.slice(1) : digits;
	}

	if (form) {
		const existing = new Set<string>(JSON.parse(document.getElementById('np-existing')!.textContent || '[]'));
		// Also warn about numbers added through this form since the last deploy.
		fetch('/api/practices/added')
			.then((r) => (r.ok ? r.json() : {}))
			.then((added: Record<string, unknown>) => Object.keys(added).forEach((n) => existing.add(n)))
			.catch(() => {});
		const summary = form.querySelector<HTMLElement>('[data-np-summary]')!;
		const summaryList = form.querySelector<HTMLElement>('[data-np-summary-list]')!;
		const doneText = document.querySelector<HTMLElement>('[data-np-done-text]')!;
		const view = document.querySelector<HTMLAnchorElement>('[data-np-view]')!;
		const rows = [...form.querySelectorAll<HTMLTableRowElement>('[data-np-day]')];
		const field = (name: string) => form.elements.namedItem(name) as HTMLInputElement;
		const submit = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
		const done = document.querySelector<HTMLElement>('[data-np-done]')!;
		const again = document.querySelector<HTMLButtonElement>('[data-np-again]')!;

		// Disable the time inputs on days marked closed.
		for (const row of rows) {
			const closed = row.querySelector<HTMLInputElement>('[data-np-closed]')!;
			const sync = () =>
				row.querySelectorAll<HTMLInputElement>('input[type="time"]').forEach((t) => (t.disabled = closed.checked));
			closed.addEventListener('change', sync);
			sync();
		}

		const copy = form.querySelector<HTMLButtonElement>('[data-np-copy]')!;
		copy.hidden = false;
		copy.addEventListener('click', () => {
			const [mon, ...rest] = rows;
			const get = (r: HTMLElement, sel: string) => r.querySelector<HTMLInputElement>(sel)!;
			for (const row of rest.slice(0, 4)) {
				for (const sel of ['[data-np-open]', '[data-np-close]', '[data-np-closed]']) {
					get(row, sel).value = get(mon, sel).value;
					get(row, sel).checked = get(mon, sel).checked;
					get(row, sel).dispatchEvent(new Event('change'));
				}
			}
		});

		/** Lists problems at the top of the form; each with an id links to its field. */
		function showProblems(problems: { id?: string; message: string }[]) {
			summaryList.replaceChildren(
				...problems.map((p) => {
					const li = document.createElement('li');
					if (!p.id) {
						li.textContent = p.message;
						return li;
					}
					const a = document.createElement('a');
					a.href = `#${p.id}`;
					a.textContent = p.message;
					a.addEventListener('click', (ev) => {
						ev.preventDefault();
						document.getElementById(p.id!)?.focus();
					});
					li.append(a);
					return li;
				}),
			);
			summary.hidden = false;
			summary.focus();
		}

		form.addEventListener('submit', async (e) => {
			e.preventDefault();
			const problems: { id: string; message: string }[] = [];
			const fail = (el: HTMLElement, message: string) => {
				el.setAttribute('aria-invalid', 'true');
				problems.push({ id: el.id, message });
			};
			form.querySelectorAll('[aria-invalid]').forEach((el) => el.removeAttribute('aria-invalid'));

			const name = field('practice_name');
			if (!name.value.trim()) fail(name, 'Enter the practice name.');

			const numbersField = form.querySelector<HTMLTextAreaElement>('#np-numbers')!;
			const lines = numbersField.value.split('\n').map((l) => l.trim()).filter(Boolean);
			const numbers = lines.map(normalize);
			const bad = lines.filter((_, i) => numbers[i].length !== 10);
			const taken = numbers.filter((n) => existing.has(n));
			const repeated = numbers.filter((n, i) => numbers.indexOf(n) !== i);
			if (!lines.length) fail(numbersField, 'Enter at least one phone number.');
			else if (bad.length) fail(numbersField, `These aren't 10-digit phone numbers: ${bad.join(', ')}`);
			else if (repeated.length) fail(numbersField, `This number is listed twice: ${repeated.join(', ')}`);
			else if (taken.length) fail(numbersField, `Already on the site: ${taken.join(', ')}. Ask the site owner to update it instead.`);

			const zip = field('zip');
			if (zip.value.trim() && !/^\d{5}(-\d{4})?$/.test(zip.value.trim())) fail(zip, 'ZIP should be 5 digits, e.g. 33602.');

			const tz = form.querySelector<HTMLSelectElement>('#np-tz')!;
			if (!tz.value) fail(tz, 'Choose a time zone.');

			const hours = rows.map((row) => {
				const day = row.querySelector('th')!.textContent!;
				const open = row.querySelector<HTMLInputElement>('[data-np-open]')!;
				const close = row.querySelector<HTMLInputElement>('[data-np-close]')!;
				if (row.querySelector<HTMLInputElement>('[data-np-closed]')!.checked) return 'Closed';
				if (!open.value && !close.value) return '';
				open.id ||= `np-${row.dataset.npDay}-open`;
				close.id ||= `np-${row.dataset.npDay}-close`;
				if (!open.value) fail(open, `${day}: enter an opening time, or tick "Closed all day".`);
				else if (!close.value) fail(close, `${day}: enter a closing time, or tick "Closed all day".`);
				else if (close.value <= open.value) fail(close, `${day}: closing time must be after opening time.`);
				return open.value && close.value ? `${to12h(open.value)} – ${to12h(close.value)}` : '';
			});

			const submitter = field('submitted_by');
			if (!submitter.value.trim()) fail(submitter, 'Enter your name so we can follow up.');

			const email = field('email');
			if (email.value.trim() && !email.checkValidity()) fail(email, 'Enter a valid email address, or leave it blank.');

			const passcode = field('passcode');
			if (!passcode.value) fail(passcode, 'Enter the team passcode.');

			if (problems.length) {
				showProblems(problems);
				return;
			}
			summary.hidden = true;

			const payload = {
				passcode: passcode.value,
				// Sent as typed (one per line) so the server can reject letters or a minus sign rather than
				// have them silently stripped here.
				numbers: lines,
				practice_name: name.value,
				address_line1: field('address_line1').value,
				address_line2: field('address_line2').value,
				city: field('city').value,
				state: field('state').value,
				zip: zip.value,
				hours,
				timezone: tz.value,
				notes: field('notes').value,
				submitted_by: submitter.value,
				email: email.value,
				bot_field: field('bot_field').value,
			};

			submit.disabled = true;
			submit.textContent = 'Adding…';
			try {
				const res = await fetch('/api/practices', {
					method: 'POST',
					headers: { 'Content-Type': 'application/json' },
					body: JSON.stringify(payload),
				});
				const data = await res.json().catch(() => ({}));
				if (!res.ok) {
					const target = data.field ? form.querySelector<HTMLElement>(`[name="${data.field}"]`) : null;
					target?.setAttribute('aria-invalid', 'true');
					const list: string[] = data.problems?.length ? data.problems : [`Something went wrong (error ${res.status}). Try again.`];
					showProblems(list.map((message) => ({ id: target?.id, message })));
					return;
				}

				// The rows as saved in entries.csv (one per phone number), so the message shows what was stored.
				const entries: { number: string; practice_name: string }[] = data.entries ?? [];
				const saved = entries.map((e) => e.number);
				saved.forEach((n) => existing.add(n));
				// The practice lookup listens for this and can find the new numbers straight away.
				document.dispatchEvent(new CustomEvent('practices:added', { detail: data.practices }));
				doneText.textContent =
					`${entries[0]?.practice_name ?? name.value.trim()} is now in the practice lookup under ` +
					`${saved.map((n) => `(${n.slice(0, 3)}) ${n.slice(3, 6)}-${n.slice(6)}`).join(', ')}.`;
				view.dataset.number = saved[0];
				form.hidden = true;
				done.hidden = false;
				done.focus();
			} catch {
				showProblems([{ message: "Sorry, the practice couldn't be added. Check your connection and try again." }]);
			} finally {
				submit.disabled = false;
				submit.textContent = 'Add practice';
			}
		});

		again.addEventListener('click', () => {
			const keep = field('passcode').value;
			form.reset();
			field('passcode').value = keep;
			rows.forEach((r) => r.querySelector('[data-np-closed]')!.dispatchEvent(new Event('change')));
			done.hidden = true;
			form.hidden = false;
			field('practice_name').focus();
		});

		// Jump to the lookup with the new number already searched.
		view.addEventListener('click', () => {
			document.dispatchEvent(new CustomEvent('practices:lookup', { detail: view.dataset.number }));
		});

		form.hidden = false;
	}
</script>

<style>
	.np {
		max-width: 44rem;
	}

	.np[hidden] {
		display: none;
	}

	.np-done {
		max-width: 44rem;
		padding: 1.25rem;
		border: 1px solid var(--color-accent);
		border-radius: 0.75rem;
		background: var(--color-accent-soft);
		color: var(--color-on-accent-soft);
	}

	.np-done-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		margin: 0;
	}

	.np-passcode {
		margin-top: 0.9rem;
		max-width: 20rem;
	}

	.np-done h3 {
		margin: 0 0 0.5rem;
		font-size: 1.15rem;
	}

	fieldset {
		margin: 0 0 1.5rem;
		padding: 1rem 1.25rem 1.25rem;
		border: 1px solid var(--color-border);
		border-radius: 0.75rem;
		background: var(--color-surface);
	}

	legend {
		padding-inline: 0.35rem;
		font-weight: 700;
		font-size: 1.05rem;
	}

	.np-field {
		display: grid;
		gap: 0.3rem;
		margin-bottom: 0.9rem;
	}

	.np-field:last-child {
		margin-bottom: 0;
	}

	.np-row {
		display: flex;
		flex-wrap: wrap;
		gap: 0 0.75rem;
	}

	.np-row > .np-field {
		flex: 1 1 12rem;
		margin-bottom: 0;
	}

	.np-row > .np-state {
		flex: 0 0 5rem;
	}

	.np-row > .np-zip {
		flex: 0 1 8rem;
	}

	label {
		font-weight: 600;
		font-size: 0.9rem;
	}

	.req {
		font-weight: 400;
		color: var(--color-text-muted);
	}

	.hint {
		margin: 0 0 0.25rem;
		color: var(--color-text-muted);
		font-size: 0.9rem;
	}

	input:not([type='checkbox']),
	select,
	textarea {
		width: 100%;
		min-height: 2.75rem;
		padding: 0.5rem 0.75rem;
		border: 1px solid var(--color-border);
		border-radius: 0.375rem;
		background: var(--color-surface-raised);
		color: var(--color-text);
		font: inherit;
	}

	input:disabled {
		opacity: 0.5;
	}

	input::placeholder,
	textarea::placeholder {
		color: var(--color-text-muted);
	}

	input[type='checkbox'] {
		width: 1.25rem;
		height: 1.25rem;
		accent-color: var(--color-accent);
	}

	[aria-invalid='true'] {
		border-color: var(--color-error) !important;
		outline: 1px solid var(--color-error);
	}

	.np-hours {
		width: 100%;
		border-collapse: collapse;
		margin-bottom: 1rem;
	}

	.np-hours th,
	.np-hours td {
		padding: 0.35rem 0.4rem;
		border-bottom: 1px solid var(--color-border);
		text-align: left;
	}

	.np-hours thead th {
		font-size: 0.85rem;
		color: var(--color-text-muted);
	}

	.np-hours td:last-child,
	.np-hours th:last-child {
		text-align: center;
	}

	.np-hours input[type='time'] {
		min-width: 7.5rem;
	}

	.np-summary {
		margin-bottom: 1.5rem;
		padding: 1rem 1.25rem;
		border: 2px solid var(--color-error);
		border-radius: 0.75rem;
		background: var(--color-surface-raised);
	}

	.np-summary-title {
		font-size: 1.1rem;
		color: var(--color-error);
	}

	.np-summary ul {
		margin: 0;
		padding-left: 1.25rem;
	}

	.np-summary a {
		color: var(--color-error);
	}

	@media (max-width: 30rem) {
		fieldset {
			padding: 0.85rem 0.75rem 1rem;
		}

		.np-hours thead {
			font-size: 0.8rem;
		}

		.np-hours th,
		.np-hours td {
			padding-inline: 0.2rem;
		}

		.np-hours input[type='time'] {
			min-width: 0;
			padding-inline: 0.3rem;
		}
	}
</style>
