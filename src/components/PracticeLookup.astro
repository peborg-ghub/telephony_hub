---
import { loadPractices } from '../lib/practices';

// Validated at build time; a bad CSV fails the build before anything ships.
const practices = loadPractices();
// Escape "<" so data can never close the <script> tag early.
const json = JSON.stringify(practices).replace(/</g, '\\u003c');
---

<div class="lookup" data-lookup>
	<h3 id="lookup-heading">Practice lookup</h3>
	<p class="intro">Enter a practice phone number to see its name, address and hours.</p>

	<noscript><p class="placeholder">Practice lookup needs JavaScript turned on in your browser.</p></noscript>

	<form class="form" data-lookup-form novalidate hidden aria-labelledby="lookup-heading">
		<div class="field">
			<label for="lookup-number">Phone number</label>
			<input
				id="lookup-number"
				name="number"
				type="tel"
				inputmode="tel"
				autocomplete="off"
				placeholder="(813) 555-0101"
				aria-describedby="lookup-status"
				data-lookup-input
			/>
		</div>
		<button type="submit" class="btn">Look up</button>
	</form>

	<p id="lookup-status" class="status" aria-live="polite" data-lookup-status></p>
	<div data-lookup-result></div>

	<script type="application/json" id="practice-data" set:html={json} />
</div>

<script>
	interface Practice {
		name: string;
		address: string[];
		hours: string[];
		tz: string;
		notes?: string;
	}

	const DAY_NAMES = ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'];
	const SHORT = ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'];

	/** Strips formatting; drops a leading country code 1 from 11 digits. */
	function normalize(value: string): string {
		const digits = value.replace(/\D/g, '');
		return digits.length === 11 && digits.startsWith('1') ? digits.slice(1) : digits;
	}

	function pretty(n: string): string {
		return `(${n.slice(0, 3)}) ${n.slice(3, 6)}-${n.slice(6)}`;
	}

	/** Index (0 = Monday) of today's weekday in the practice's own time zone. */
	function todayIndex(tz: string): number {
		try {
			const short = new Intl.DateTimeFormat('en-US', { weekday: 'short', timeZone: tz }).format(new Date());
			return SHORT.indexOf(short);
		} catch {
			return -1;
		}
	}

	function zoneLabel(tz: string): string {
		try {
			const part = new Intl.DateTimeFormat('en-US', { timeZone: tz, timeZoneName: 'longGeneric' })
				.formatToParts(new Date())
				.find((p) => p.type === 'timeZoneName');
			return part ? `${part.value} (${tz})` : tz;
		} catch {
			return tz;
		}
	}

	function el<K extends keyof HTMLElementTagNameMap>(tag: K, className?: string, text?: string) {
		const node = document.createElement(tag);
		if (className) node.className = className;
		if (text !== undefined) node.textContent = text;
		return node;
	}

	function renderResult(number: string, p: Practice): HTMLElement {
		const card = el('article', 'result');
		card.setAttribute('aria-labelledby', 'lookup-result-name');

		const top = el('p', 'result-number', `Result for ${pretty(number)}`);
		const name = el('h4', 'result-name', p.name);
		name.id = 'lookup-result-name';
		card.append(top, name);

		if (p.address.length) {
			const address = el('address', 'result-address');
			p.address.forEach((line, i) => {
				if (i) address.append(el('br'));
				address.append(document.createTextNode(line));
			});
			card.append(address);
		}

		const today = todayIndex(p.tz);
		const table = el('table', 'hours');
		table.append(el('caption', undefined, 'Hours of operation'));
		const body = el('tbody');
		DAY_NAMES.forEach((day, i) => {
			const row = el('tr');
			const th = el('th', undefined, day);
			th.scope = 'row';
			const td = el('td', undefined, p.hours[i] || 'Not listed');
			if (i === today) {
				row.className = 'today';
				th.append(el('span', 'today-badge', 'Today'));
			}
			row.append(th, td);
			body.append(row);
		});
		table.append(body);
		card.append(table);

		const meta = el('dl', 'result-meta');
		meta.append(el('dt', undefined, 'Time zone'), el('dd', undefined, zoneLabel(p.tz)));
		if (p.notes) meta.append(el('dt', undefined, 'Notes'), el('dd', undefined, p.notes));
		card.append(meta);

		return card;
	}

	const root = document.querySelector<HTMLElement>('[data-lookup]');
	if (root) {
		const data: Record<string, Practice> = JSON.parse(document.getElementById('practice-data')!.textContent || '{}');
		const form = root.querySelector<HTMLFormElement>('[data-lookup-form]')!;
		const input = root.querySelector<HTMLInputElement>('[data-lookup-input]')!;
		const status = root.querySelector<HTMLElement>('[data-lookup-status]')!;
		const result = root.querySelector<HTMLElement>('[data-lookup-result]')!;

		function show(message: string, isError: boolean) {
			status.textContent = message;
			status.classList.toggle('is-error', isError);
			input.setAttribute('aria-invalid', String(isError));
		}

		form.addEventListener('submit', (e) => {
			e.preventDefault();
			result.replaceChildren();
			const number = normalize(input.value);

			if (number.length !== 10) {
				show('Enter a 10-digit number.', true);
			} else if (!data[number]) {
				show(`No practice found for ${pretty(number)}.`, false);
			} else {
				show(`Found ${data[number].name} for ${pretty(number)}.`, false);
				result.append(renderResult(number, data[number]));
			}
			input.focus();
		});

		form.hidden = false;
	}
</script>

<style>
	.lookup {
		margin-bottom: 2rem;
		padding: 1.25rem;
		border: 1px solid var(--color-border);
		border-radius: 0.75rem;
		background: var(--color-surface);
	}

	.intro {
		color: var(--color-text-muted);
	}

	.form {
		display: flex;
		flex-wrap: wrap;
		align-items: flex-end;
		gap: 0.75rem;
	}

	.form[hidden] {
		display: none;
	}

	.field {
		display: grid;
		gap: 0.3rem;
		flex: 1 1 14rem;
		max-width: 20rem;
	}

	label {
		font-weight: 600;
		font-size: 0.9rem;
	}

	input {
		min-height: 2.75rem;
		padding: 0.5rem 0.75rem;
		border: 1px solid var(--color-border);
		border-radius: 0.375rem;
		background: var(--color-surface-raised);
		color: var(--color-text);
		font: inherit;
		font-size: 1.05rem;
		letter-spacing: 0.02em;
	}

	input::placeholder {
		color: var(--color-text-muted);
	}

	input[aria-invalid='true'] {
		border-color: var(--color-error);
	}

	.form .btn {
		min-height: 2.75rem;
	}

	.status {
		margin: 0.85rem 0 0;
		min-height: 1.5em;
		font-weight: 500;
	}

	.status.is-error {
		color: var(--color-error);
	}

	.lookup :global(.result) {
		margin-top: 1rem;
		padding: 1.25rem;
		border: 1px solid var(--color-border);
		border-radius: 0.6rem;
		background: var(--color-surface-raised);
		box-shadow: 0 1px 3px var(--color-shadow);
		max-width: 40rem;
	}

	.lookup :global(.result-number) {
		margin: 0;
		color: var(--color-text-muted);
		font-size: 0.9rem;
	}

	.lookup :global(.result-name) {
		margin: 0.2rem 0 0.6rem;
		font-size: 1.3rem;
	}

	.lookup :global(.result-address) {
		font-style: normal;
		margin-bottom: 1rem;
	}

	.lookup :global(.hours) {
		width: 100%;
		border-collapse: collapse;
		font-size: 0.95rem;
	}

	.lookup :global(.hours caption) {
		text-align: left;
		font-weight: 700;
		padding-bottom: 0.4rem;
	}

	.lookup :global(.hours th),
	.lookup :global(.hours td) {
		padding: 0.45rem 0.6rem;
		border-bottom: 1px solid var(--color-border);
		text-align: left;
	}

	.lookup :global(.hours th) {
		font-weight: 600;
		width: 45%;
	}

	.lookup :global(.hours td) {
		white-space: nowrap;
	}

	@media (max-width: 30rem) {
		.lookup {
			padding: 1rem 0.85rem;
		}

		.lookup :global(.result) {
			padding: 1rem 0.75rem;
		}

		.lookup :global(.hours th),
		.lookup :global(.hours td) {
			padding-inline: 0.4rem;
		}

		.lookup :global(.hours th) {
			width: auto;
		}
	}

	.lookup :global(.hours tr.today) {
		background: var(--color-accent-soft);
		color: var(--color-on-accent-soft);
	}

	.lookup :global(.today-badge) {
		margin-left: 0.5rem;
		padding: 0.05rem 0.45rem;
		border-radius: 999px;
		background: var(--color-accent);
		color: var(--color-on-accent);
		font-size: 0.75rem;
		font-weight: 700;
	}

	.lookup :global(.result-meta) {
		display: grid;
		grid-template-columns: max-content 1fr;
		gap: 0.3rem 1rem;
		margin: 1rem 0 0;
		font-size: 0.95rem;
	}

	.lookup :global(.result-meta dt) {
		font-weight: 600;
	}

	.lookup :global(.result-meta dd) {
		margin: 0;
		color: var(--color-text-muted);
	}
</style>
