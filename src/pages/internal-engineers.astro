---
import BaseLayout from '../layouts/BaseLayout.astro';
import Library from '../components/Library.astro';
import { getLibrary, SUBSECTION_INFO } from '../lib/documents';
import { SUBSECTIONS } from '../lib/documents-schema';

const aiLibraries = await Promise.all(
	SUBSECTIONS.map(async (id) => ({ id, label: SUBSECTION_INFO[id].label, docs: await getLibrary('ai-projects', id) })),
);
const powerBiDocs = await getLibrary('power-bi');
---

<BaseLayout title="Internal Engineers" description="AI project and Power BI resources for Cloud Telephony engineers.">
	<div class="container page-header">
		<h1>Internal Engineers</h1>
		<p>AI project documents and Power BI reports.</p>
	</div>

	<section class="container section" id="ai-projects" aria-labelledby="ai-projects-heading">
		<h2 class="section-heading" id="ai-projects-heading">
			AI Projects <a class="anchor-link" href="#ai-projects" aria-label="Link to AI Projects">#</a>
		</h2>
		<nav class="jump" aria-label="AI projects">
			{aiLibraries.map((lib) => <a href={`#${lib.id}`}>{lib.label}</a>)}
		</nav>

		{
			aiLibraries.map((lib) => (
				<section class="subsection" id={lib.id} aria-labelledby={`${lib.id}-heading`}>
					<h3 class="section-heading" id={`${lib.id}-heading`}>
						{lib.label}
						<a class="anchor-link" href={`#${lib.id}`} aria-label={`Link to ${lib.label}`}>
							#
						</a>
					</h3>
					<Library id={lib.id} label={lib.label} docs={lib.docs} headingLevel={4} />
				</section>
			))
		}
	</section>

	<section class="container section" id="power-bi" aria-labelledby="power-bi-heading">
		<h2 class="section-heading" id="power-bi-heading">
			Power BI <a class="anchor-link" href="#power-bi" aria-label="Link to Power BI">#</a>
		</h2>
		<Library id="power-bi" label="Power BI" docs={powerBiDocs} headingLevel={3} />
	</section>
</BaseLayout>

<style>
	.jump {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
	}

	.jump a {
		padding: 0.3rem 0.8rem;
		border: 1px solid var(--color-border);
		border-radius: 999px;
		text-decoration: none;
		font-size: 0.9rem;
		font-weight: 500;
	}

	.jump a:hover {
		border-color: var(--color-accent);
	}
</style>
